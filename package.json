{
  "name": "stow",
  "version": "0.1.0",
  "private": true,
  "description": "See what your Mac is holding, and what it can let go.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx src/shared/segments.test.ts && tsx src/shared/items.test.ts && tsx src/shared/version.test.ts && tsx src/shared/listing.test.ts",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "demo": "STOW_DEMO=1 electron-vite dev"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-progress": "*",
    "@radix-ui/react-scroll-area": "*",
    "@radix-ui/react-separator": "*",
    "@radix-ui/react-slot": "*",
    "@radix-ui/react-tabs": "*",
    "@radix-ui/react-tooltip": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "tailwind-merge": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "electron": "*",
    "electron-builder": "^26.15.3",
    "electron-vite": "*",
    "tailwindcss": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*"
  },
  "build": {
    "appId": "com.kthilagarajan.stow",
    "productName": "Stow",
    "copyright": "Scanning stays on this Mac.",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.icns",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kthilagarajan/stow.git"
  },
  "license": "MIT",
  "homepage": "https://kthilagarajan.github.io/stow/"
}
