---
// A screenshot that follows the visitor's light or dark setting when both versions exist.
interface Props {
  light?: string
  dark?: string
  alt: string
  class?: string
  eager?: boolean
}

const { light, dark, alt, class: className, eager = false } = Astro.props
const base = import.meta.env.BASE_URL
const fallback = (light ?? dark)!
---

<picture>
  {dark && light && <source srcset={`${base}screenshots/${dark}`} media="(prefers-color-scheme: dark)" />}
  <img
    class:list={['w-full rounded-2xl border border-line shadow-2xl shadow-black/15', className]}
    src={`${base}screenshots/${fallback}`}
    width="1600"
    height="1075"
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>
